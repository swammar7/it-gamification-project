# System files (ignore these as they are specific to your machine)
.DS_Store
Thumbs.db

# Dependencies (if you ever use them later, like Node.js)
node_modules/
package-lock.json

# Local logs and debug files
*.log
npm-debug.log*
yarn-debug.log*

# Editor/IDE configurations (prevents sharing your personal settings)
.vscode/
.idea/

# Your game's local backup or temporary files
*.tmp
temp/